# ==========================================
# NeuroWrite AI - .gitignore
# ==========================================

# R environment & history
.Rhistory
.RData
.Ruserdata
.Rproj.user/
.Renviron

# Raw Neurophysiological Datasets (Kaggle ~1GB .mat files)
data/raw/*
!data/raw/.gitkeep
*.mat
*.crdownload
*.h5
*.hdf5
*.dat
*.bin

# Temporary and build files
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp

# R Markdown temporary outputs
*.knit.md
*.utf8.md

# Package archives
*.tar.gz
*.Rcheck/
